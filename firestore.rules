rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'ferdinandkouadio1996@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNewSoul(data) {
      return data.keys().hasAll([
        'receptionDate', 'gender', 'lastName', 'firstNames', 'neighborhood',
        'phoneNumber', 'prayerCell', 'canReceiveVisit', 'knowsSomeoneInChurch', 'recordedByName'
      ])
      && data.receptionDate is string && data.receptionDate.size() <= 30
      && (data.gender in ['HOMME', 'FEMME', 'JEUNE', 'ENFANT'])
      && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100
      && data.firstNames is string && data.firstNames.size() > 0 && data.firstNames.size() <= 150
      && data.neighborhood is string && data.neighborhood.size() > 0 && data.neighborhood.size() <= 150
      && data.phoneNumber is string && data.phoneNumber.size() > 0 && data.phoneNumber.size() <= 30
      && data.prayerCell is string && data.prayerCell.size() <= 100
      && data.canReceiveVisit is bool
      && data.knowsSomeoneInChurch is bool
      && data.recordedByName is string && data.recordedByName.size() <= 150;
    }

    function isValidPrayerCell(data) {
      return data.keys().hasAll(['name', 'neighborhood', 'leaderName', 'leaderPhone'])
      && data.name is string && data.name.size() > 0 && data.name.size() <= 100
      && data.neighborhood is string && data.neighborhood.size() > 0 && data.neighborhood.size() <= 100
      && data.leaderName is string && data.leaderName.size() > 0 && data.leaderName.size() <= 100
      && data.leaderPhone is string && data.leaderPhone.size() > 0 && data.leaderPhone.size() <= 30;
    }

    // New souls collection - Real-time multi-user collaborative sync
    match /newSouls/{soulId} {
      allow get, list: if true;
      allow create, update: if isValidId(soulId) && isValidNewSoul(request.resource.data);
      allow delete: if true;
    }

    // Prayer cells collection
    match /prayerCells/{cellId} {
      allow get, list: if true;
      allow create, update: if isValidId(cellId) && isValidPrayerCell(request.resource.data);
      allow delete: if true;
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
